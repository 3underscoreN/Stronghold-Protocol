# Copy this file to .env and set the values from your Google OAuth client.
OAUTH2_PROXY_CLIENT_ID=replace-with-google-oauth-client-id
OAUTH2_PROXY_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Generate a URL-safe base64 cookie secret (16, 24, or 32 random bytes).
OAUTH2_PROXY_COOKIE_SECRET=replace-with-generated-cookie-secret
# Must exactly match the public HTTPS URL registered in Google Cloud.
OAUTH2_PROXY_REDIRECT_URL=https://game.example.com/oauth2/callback
